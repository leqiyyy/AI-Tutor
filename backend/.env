# Development environment - SQLite (no Docker needed)
ENV=development
DEBUG=true
SECRET_KEY=dev-secret-key-change-in-production-32ch
AUTO_CREATE_TABLES=true

# SQLite for local dev (switch to PostgreSQL for production)
DATABASE_URL=sqlite:///./ai_tutor.db

# Redis - set REDIS_AVAILABLE=false to skip Redis
REDIS_AVAILABLE=false
REDIS_URL=redis://localhost:6379/0

# Storage
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./uploads

# CORS
CORS_ORIGINS_STR=http://localhost:5173,http://localhost:3000

# LLM (mock by default)
LLM_PROVIDER=mock
RAG_ENGINE=mock

# Email (dev mode logs to console)
EMAIL_DEV_MODE=true

RAG_ENGINE=raganything

RAG_ENGINE=raganything

LLM_MODEL=gpt-5.4
