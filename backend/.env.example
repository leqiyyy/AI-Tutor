# Application
APP_NAME=AI Tutor Backend
ENV=development
DEBUG=true
SECRET_KEY=your-secret-key-change-in-production-must-be-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=10080
AUTO_CREATE_TABLES=true

# Database
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/ai_tutor
# For SQLite local development:
# DATABASE_URL=sqlite:///./ai_tutor.db

# Redis
REDIS_AVAILABLE=false
REDIS_URL=redis://localhost:6379/0

# MinIO / Storage
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./uploads
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=ai-tutor
MINIO_SECURE=false

# CORS
CORS_ORIGINS_STR=http://localhost:5173,http://localhost:3000

# LLM Provider / Routing
LLM_PROVIDER=openai
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_API_BASE=
LLM_MODEL=claude-opus-4-6
LLM_API_KEY=
LLM_API_BASE=
LLM_WIRE_API=responses
LLM_BACKEND=api
LLM_LOCAL_API_BASE=
EXTRACT_MODEL=
EXTRACT_API_KEY=
EXTRACT_API_BASE=
EXTRACT_WIRE_API=chat_completions
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
EMBEDDING_API_KEY=
EMBEDDING_API_BASE=
EMBEDDING_BACKEND=api
EMBEDDING_LOCAL_API_BASE=
VLM_MODEL=
VLM_API_KEY=
VLM_API_BASE=
VLM_WIRE_API=chat_completions
VLM_BACKEND=api
VLM_LOCAL_API_BASE=
RERANKER_PROVIDER=api
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_API_BASE=https://api.siliconflow.cn/v1
RERANKER_API_KEY=
RERANKER_API_PATH=/rerank
RERANKER_API_TIMEOUT_SECONDS=20
RERANKER_LOCAL_MODEL=BAAI/bge-reranker-v2-m3

# RAG Engine (strict RAG-Anything main chain)
RAG_ENGINE=raganything
RAGANYTHING_STRICT_MODE=true
RAGANYTHING_METADATA_FALLBACK_ENABLED=false
RAGANYTHING_REQUIRE_OFFICIAL_METADATA=true
LIBREOFFICE_PATH=
RAGANYTHING_WORKING_DIR=./rag_storage
RAGANYTHING_OUTPUT_DIR=./rag_output
RAGANYTHING_PARSER=mineru
RAGANYTHING_PARSE_METHOD=auto
RAGANYTHING_QUERY_MODE=mix
RAGANYTHING_MAX_CONCURRENT_FILES=1
RAGANYTHING_DEFAULT_LLM_TIMEOUT_SECONDS=180
RAG_STORAGE_BACKEND=lightrag-default
VECTOR_DB_PROVIDER=auto
VECTOR_DB_URL=
VECTOR_DB_API_KEY=
VECTOR_DB_COLLECTION=raganything_chunks
GRAPH_DB_PROVIDER=auto
GRAPH_DB_URL=
GRAPH_DB_DATABASE=neo4j
GRAPH_DB_USERNAME=
GRAPH_DB_PASSWORD=
RAG_RETRIEVAL_STRATEGY=hybrid
RAG_RETRIEVAL_CANDIDATE_K=12
RAG_ANSWER_TOP_K=3
RAG_QUERY_REWRITE_ENABLED=true
RAG_QUERY_REWRITE_MODE=hybrid
RAG_QUERY_REWRITE_MAX_VARIANTS=3
RAG_QUERY_TRACE_ENABLED=true
RAG_QUERY_TRACE_PREVIEW_CHARS=1200
RAG_QUERY_TRACE_FULL_RAW_ANSWER_ENABLED=false
RAG_QUERY_TRACE_FULL_RAW_ANSWER_MAX_CHARS=20000
RAG_ANSWER_REPAIR_POLICY=severe_only

# Multimodal preprocessing
MULTIMODAL_ALLOW_METADATA_ONLY_INDEX=true
MULTIMODAL_AUTO_PREPROCESS_ENABLED=false
MULTIMODAL_PREPROCESS_OUTPUT_DIR=./runtime_tmp/multimodal_preprocess
MULTIMODAL_FFMPEG_PATH=ffmpeg
MULTIMODAL_FFPROBE_PATH=ffprobe
MULTIMODAL_VIDEO_KEYFRAME_INTERVAL_SECONDS=30
MULTIMODAL_VIDEO_MAX_KEYFRAMES=8
ASR_PROVIDER=none
ASR_MODEL=base
ASR_LANGUAGE=
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8
ASR_API_BASE=
ASR_API_KEY=
ASR_API_PATH=/audio/transcriptions
ASR_API_TIMEOUT_SECONDS=120
ASR_API_AUTH_HEADER=Authorization
ASR_API_AUTH_SCHEME=Bearer

# Email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@ai-tutor.com
EMAIL_DEV_MODE=true

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
