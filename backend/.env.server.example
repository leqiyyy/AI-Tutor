# Server deployment example for API-first thesis testing.
# Copy to `backend/.env.server` before running docker compose.

# Application
APP_NAME=AI Tutor Backend
ENV=production
DEBUG=false
APP_TIMEZONE=Asia/Shanghai
SECRET_KEY=change-this-secret-key-before-deploying
ACCESS_TOKEN_EXPIRE_MINUTES=10080
AUTO_CREATE_TABLES=false
SEED_DEMO_DATA=true

# Database / Redis
POSTGRES_DB=ai_tutor
POSTGRES_USER=ai_tutor
POSTGRES_PASSWORD=ai_tutor
DATABASE_URL=postgresql+psycopg2://ai_tutor:ai_tutor@db:5432/ai_tutor
REDIS_AVAILABLE=true
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Storage
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=/app/uploads
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=ai-tutor
MINIO_SECURE=false
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123

# CORS
CORS_ORIGINS_STR=http://localhost:5173,http://localhost:3000,https://your-frontend-domain

# API-first model routing
LLM_PROVIDER=openai
LLM_BACKEND=api
LLM_MODEL=
LLM_API_BASE=
LLM_API_KEY=
LLM_WIRE_API=responses
LLM_TEMPERATURE=0.3
LLM_TOP_P=0.8
LLM_ENABLE_THINKING=false
LLM_THINKING_BUDGET=4096
LLM_LOCAL_API_BASE=

EXTRACT_MODEL=
EXTRACT_API_BASE=
EXTRACT_API_KEY=
EXTRACT_WIRE_API=chat_completions
EXTRACT_TEMPERATURE=0
EXTRACT_TOP_P=0.8
EXTRACT_MAX_TOKENS=4096
EXTRACT_ENABLE_THINKING=false
EXTRACT_THINKING_BUDGET=512

EMBEDDING_BACKEND=api
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_API_BASE=
EMBEDDING_API_KEY=
EMBEDDING_DIM=1024
EMBEDDING_LOCAL_API_BASE=

VLM_BACKEND=api
VLM_MODEL=
VLM_API_BASE=
VLM_API_KEY=
VLM_WIRE_API=chat_completions
VLM_TEMPERATURE=0.1
VLM_TOP_P=0.8
VLM_ENABLE_THINKING=false
VLM_THINKING_BUDGET=1024
VLM_LOCAL_API_BASE=
STRIP_THINKING_BLOCKS=true

RERANKER_PROVIDER=api
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_API_BASE=https://api.siliconflow.cn/v1
RERANKER_API_KEY=
RERANKER_API_PATH=/rerank
RERANKER_API_TIMEOUT_SECONDS=20
RERANKER_LOCAL_MODEL=BAAI/bge-reranker-v2-m3

# RAG main chain
RAG_ENGINE=raganything
RAGANYTHING_STRICT_MODE=true
RAGANYTHING_METADATA_FALLBACK_ENABLED=false
RAGANYTHING_REQUIRE_OFFICIAL_METADATA=true
LIBREOFFICE_PATH=/usr/bin/soffice
RAGANYTHING_WORKING_DIR=/app/rag_storage
RAGANYTHING_OUTPUT_DIR=/app/rag_output
RAGANYTHING_PARSER=mineru
RAGANYTHING_PARSE_METHOD=auto
RAGANYTHING_QUERY_MODE=mix
RAGANYTHING_MAX_CONCURRENT_FILES=1
RAGANYTHING_DEFAULT_LLM_TIMEOUT_SECONDS=180
MINERU_MODEL_SOURCE=modelscope

# External storage topology
RAG_STORAGE_BACKEND=qdrant-neo4j
VECTOR_DB_PROVIDER=qdrant
VECTOR_DB_URL=http://qdrant:6333
VECTOR_DB_API_KEY=
VECTOR_DB_COLLECTION=raganything_chunks
GRAPH_DB_PROVIDER=neo4j
GRAPH_DB_URL=bolt://neo4j:7687
GRAPH_DB_DATABASE=neo4j
GRAPH_DB_USERNAME=neo4j
GRAPH_DB_PASSWORD=change_me

# Retrieval behavior
RAG_RETRIEVAL_STRATEGY=hybrid
RAG_RETRIEVAL_CANDIDATE_K=12
RAG_ANSWER_TOP_K=3
RAG_QUERY_REWRITE_ENABLED=true
RAG_QUERY_REWRITE_MODE=hybrid
RAG_QUERY_REWRITE_MAX_VARIANTS=3
RAG_QUERY_TRACE_ENABLED=true
RAG_QUERY_TRACE_PREVIEW_CHARS=1200
RAG_QUERY_TRACE_FULL_RAW_ANSWER_ENABLED=false
RAG_QUERY_TRACE_FULL_RAW_ANSWER_MAX_CHARS=20000
RAG_ANSWER_REPAIR_ENABLED=true
RAG_ANSWER_REPAIR_POLICY=severe_only

# Multimodal preprocessing
MULTIMODAL_ALLOW_METADATA_ONLY_INDEX=true
MULTIMODAL_AUTO_PREPROCESS_ENABLED=false
MULTIMODAL_PREPROCESS_OUTPUT_DIR=/app/runtime_tmp/multimodal_preprocess
MULTIMODAL_FFMPEG_PATH=ffmpeg
MULTIMODAL_FFPROBE_PATH=ffprobe
MULTIMODAL_VIDEO_KEYFRAME_INTERVAL_SECONDS=30
MULTIMODAL_VIDEO_MAX_KEYFRAMES=8

# ASR
ASR_PROVIDER=none
ASR_MODEL=base
ASR_LANGUAGE=
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8
ASR_API_BASE=
ASR_API_KEY=
ASR_API_PATH=/audio/transcriptions
ASR_API_TIMEOUT_SECONDS=120
ASR_API_AUTH_HEADER=Authorization
ASR_API_AUTH_SCHEME=Bearer

# Email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@ai-tutor.com
EMAIL_DEV_MODE=true
SMTP_USE_TLS=true
SMTP_USE_SSL=false
VERIFY_CODE_EXPIRE_MINUTES=10
VERIFY_CODE_COOLDOWN_SECONDS=60
VERIFY_CODE_DAILY_LIMIT=10
AUTH_LOGIN_FAILURE_LIMIT=5
AUTH_LOGIN_LOCK_SECONDS=900
